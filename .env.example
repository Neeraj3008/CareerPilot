# -------------------------------------------------------------
# CareerPilot Environment Variables Template
# -------------------------------------------------------------

# Backend Settings
PROJECT_NAME="CareerPilot"
SECRET_KEY="replace-this-with-a-secure-random-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL
# SQLite default for instant zero-configuration local runs:
DATABASE_URL="sqlite:///./careerpilot.db"
# Or PostgreSQL with pgvector:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/careerpilot"

# Gemini LLM & Embeddings API
# (Leave blank for automatic deterministic offline heuristics and test mocks)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Frontend Vite Settings
VITE_API_URL="http://localhost:8000/api/v1"
